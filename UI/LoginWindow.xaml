<Window x:Class="HamulProto.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hamul - Login" Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource TransparentBrush}" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Themes/FireTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="14" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource AccentColor}" BorderThickness="1" Margin="10">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="HAMUL" FontSize="32" FontWeight="Black" Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Center" Margin="0,20,0,30">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{DynamicResource AccentColorValue}" BlurRadius="20" ShadowDepth="0" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Email" Foreground="{DynamicResource TextWhite}" FontSize="12" Margin="0,0,0,5"/>
                <TextBox x:Name="EmailBox" Height="35" Background="{DynamicResource ControlBgBrush}" Foreground="{DynamicResource TextWhite}" BorderThickness="0" Padding="10,0" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                <TextBlock Text="Contraseña" Foreground="{DynamicResource TextWhite}" FontSize="12" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" Height="35" Background="{DynamicResource ControlBgBrush}" Foreground="{DynamicResource TextWhite}" BorderThickness="0" Padding="10,0" Margin="0,0,0,20" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="RememberCheck" Content="Recordar mi correo" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                <Button x:Name="LoginBtn" Content="Iniciar Sesión" Height="40" Background="{DynamicResource AccentGradient}" Foreground="{DynamicResource OnAccentBrush}" FontWeight="Bold" BorderThickness="0" Click="LoginBtn_Click"/>
                <Button x:Name="RegisterBtn" Content="Crear cuenta" Height="40" Background="{DynamicResource TransparentBrush}" Foreground="{DynamicResource SubTextBrush}" FontWeight="Bold" BorderThickness="0" Margin="0,10,0,0" Click="RegisterBtn_Click"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{DynamicResource AccentRed}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </Grid>
    </Border>
</Window>