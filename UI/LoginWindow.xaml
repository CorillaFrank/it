<Window x:Class="HamulProto.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LUMAH - Login" Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource TransparentBrush}"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="True" Topmost="False" PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Themes/FireTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>

            <!-- Borde normal de los inputs: rojo -> naranja, semitransparente -->
            <LinearGradientBrush x:Key="InputBorderBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#99E5252A" Offset="0"/>
                <GradientStop Color="#99FF8A1F" Offset="1"/>
            </LinearGradientBrush>

            <!-- Borde al enfocar: mismos colores, más intensos -->
            <LinearGradientBrush x:Key="InputBorderFocusBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FFE5252A" Offset="0"/>
                <GradientStop Color="#FFFF8A1F" Offset="1"/>
            </LinearGradientBrush>

            <!-- Marco de los campos: fondo #111111, esquinas 12, borde degradado -->
            <Style x:Key="InputFrame" TargetType="Border">
                <Setter Property="Background" Value="#111111"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Width" Value="320"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource InputBorderFocusBrush}"/>
                        <Setter Property="Background" Value="#151515"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Enlace de texto (Crear cuenta / Volver) -->
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentOrange}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botón principal por defecto (el de Iniciar Sesión lo ajusta a 260x40) -->
            <Style x:Key="LoginButton" TargetType="Button">
                <Setter Property="Height" Value="44"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="24,0"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="12"
                                    Background="{DynamicResource AccentGradient}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <ContentPresenter x:Name="ContentHost"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>

                                    <StackPanel x:Name="LoadingPanel" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                        <Grid Width="16" Height="16" Margin="0,0,8,0">
                                            <Ellipse Stroke="#55FFFFFF" StrokeThickness="2"/>
                                            <Path Data="M 8,0 A 8,8 0 0 1 16,8"
                                                  Stroke="White" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="SpinnerRotate" CenterX="8" CenterY="8"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                        <TextBlock Text="Cargando..." Foreground="{TemplateBinding Foreground}"
                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="loading">
                                    <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="LoadingPanel" Property="Visibility" Value="Visible"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="SpinStoryboard">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:0.8"
                                                                 RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="SpinStoryboard"/>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Sin margen: la imagen llega hasta los bordes de la ventana -->
    <Border CornerRadius="14" Background="#0A0A0C" Margin="0">
        <Grid>
            <!-- Recorte redondeado de toda la ventana -->
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,1000,700" RadiusX="14" RadiusY="14"/>
            </Grid.Clip>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45*"/>  <!-- formulario -->
                <ColumnDefinition Width="55*"/>  <!-- imagen -->
            </Grid.ColumnDefinitions>

            <!-- ================= FORMULARIO (IZQUIERDA) ================= -->
            <Grid Grid.Column="0" Background="#0A0A0C">
                <StackPanel Width="320" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- Marca -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="LUMAH" FontSize="40" FontWeight="Black"
                                   Foreground="{DynamicResource TextWhite}"/>
                        <Ellipse Width="11" Height="11" Margin="4,0,0,7" VerticalAlignment="Bottom">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E5252A" Offset="0"/>
                                    <GradientStop Color="#FF8A1F" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                    </StackPanel>

                    <!-- [KwK] con letter-spacing manual y color semitransparente -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                Margin="0,8,0,0" Opacity="0.5">
                        <TextBlock Text="[" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextGray}"/>
                        <TextBlock Text="K" FontSize="10.5" FontWeight="SemiBold" Margin="7,0,0,0"
                                   Foreground="{DynamicResource TextGray}"/>
                        <TextBlock Text="w" FontSize="10.5" FontWeight="SemiBold" Margin="7,0,0,0"
                                   Foreground="{DynamicResource TextGray}"/>
                        <TextBlock Text="K" FontSize="10.5" FontWeight="SemiBold" Margin="7,0,0,0"
                                   Foreground="{DynamicResource TextGray}"/>
                        <TextBlock Text="]" FontSize="10.5" FontWeight="SemiBold" Margin="7,0,0,0"
                                   Foreground="{DynamicResource TextGray}"/>
                    </StackPanel>

                    <!-- Login / Registro -->
                    <Grid Width="320" Margin="0,36,0,0">
                        <!-- ============ LOGIN ============ -->
                        <StackPanel x:Name="LoginPanel">
                            <TextBlock Text="Iniciar Sesión" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource TextWhite}"/>
                            <TextBlock Text="Accede a tu cuenta para continuar."
                                       FontSize="12" Foreground="{DynamicResource TextGray}"
                                       Margin="0,5,0,30"/>

                            <TextBlock Text="Email" FontSize="11" Foreground="{DynamicResource TextGray}"
                                       Margin="0,0,0,6"/>
                            <Border Style="{StaticResource InputFrame}" Margin="0,0,0,16">
                                <TextBox x:Name="EmailBox" Height="40" FontSize="13"
                                         Background="Transparent" Foreground="{DynamicResource TextWhite}"
                                         CaretBrush="{DynamicResource TextWhite}"
                                         BorderThickness="0" Padding="0"
                                         VerticalContentAlignment="Center"
                                         FocusVisualStyle="{x:Null}"/>
                            </Border>

                            <TextBlock Text="Contraseña" FontSize="11" Foreground="{DynamicResource TextGray}"
                                       Margin="0,0,0,6"/>
                            <Border Style="{StaticResource InputFrame}" Margin="0,0,0,16">
                                <PasswordBox x:Name="PasswordBox" Height="40" FontSize="13"
                                             Background="Transparent" Foreground="{DynamicResource TextWhite}"
                                             CaretBrush="{DynamicResource TextWhite}"
                                             BorderThickness="0" Padding="0"
                                             VerticalContentAlignment="Center"
                                             FocusVisualStyle="{x:Null}"/>
                            </Border>

                            <CheckBox x:Name="RememberCheck" Content="Recordar mi correo"
                                      Foreground="{DynamicResource SubTextBrush}" FontSize="12.5"/>

                            <Button x:Name="LoginBtn" Style="{StaticResource LoginButton}"
                                    Content="Iniciar Sesión" Width="260" Height="40"
                                    HorizontalAlignment="Center" Margin="0,18,0,0"
                                    Click="LoginBtn_Click"/>

                            <Button x:Name="RegisterBtn" Style="{StaticResource LinkButton}"
                                    Content="Crear cuenta" Height="30" Margin="0,12,0,0"
                                    Click="RegisterBtn_Click"/>
                        </StackPanel>

                        <!-- ============ REGISTRO ============ -->
                        <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                            <TextBlock Text="Crear cuenta" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource TextWhite}"/>
                            <TextBlock Text="Regístrate para empezar a usar LUMAH."
                                       FontSize="12" Foreground="{DynamicResource TextGray}"
                                       Margin="0,5,0,24"/>

                            <TextBlock Text="Email" FontSize="11" Foreground="{DynamicResource TextGray}"
                                       Margin="0,0,0,6"/>
                            <Border Style="{StaticResource InputFrame}" Margin="0,0,0,16">
                                <TextBox x:Name="RegisterEmailBox" Height="40" FontSize="13"
                                         Background="Transparent" Foreground="{DynamicResource TextWhite}"
                                         CaretBrush="{DynamicResource TextWhite}"
                                         BorderThickness="0" Padding="0"
                                         VerticalContentAlignment="Center"
                                         FocusVisualStyle="{x:Null}"/>
                            </Border>

                            <TextBlock Text="Nickname" FontSize="11" Foreground="{DynamicResource TextGray}"
                                       Margin="0,0,0,6"/>
                            <Border Style="{StaticResource InputFrame}" Margin="0,0,0,16">
                                <TextBox x:Name="RegisterNicknameBox" Height="40" FontSize="13"
                                         Background="Transparent" Foreground="{DynamicResource TextWhite}"
                                         CaretBrush="{DynamicResource TextWhite}"
                                         BorderThickness="0" Padding="0"
                                         VerticalContentAlignment="Center"
                                         FocusVisualStyle="{x:Null}"/>
                            </Border>

                            <TextBlock Text="Contraseña" FontSize="11" Foreground="{DynamicResource TextGray}"
                                       Margin="0,0,0,6"/>
                            <Border Style="{StaticResource InputFrame}" Margin="0,0,0,16">
                                <PasswordBox x:Name="RegisterPasswordBox" Height="40" FontSize="13"
                                             Background="Transparent" Foreground="{DynamicResource TextWhite}"
                                             CaretBrush="{DynamicResource TextWhite}"
                                             BorderThickness="0" Padding="0"
                                             VerticalContentAlignment="Center"
                                             FocusVisualStyle="{x:Null}"/>
                            </Border>

                            <TextBlock Text="Confirmar contraseña" FontSize="11" Foreground="{DynamicResource TextGray}"
                                       Margin="0,0,0,6"/>
                            <Border Style="{StaticResource InputFrame}" Margin="0,0,0,16">
                                <PasswordBox x:Name="RegisterConfirmBox" Height="40" FontSize="13"
                                             Background="Transparent" Foreground="{DynamicResource TextWhite}"
                                             CaretBrush="{DynamicResource TextWhite}"
                                             BorderThickness="0" Padding="0"
                                             VerticalContentAlignment="Center"
                                             FocusVisualStyle="{x:Null}"/>
                            </Border>

                            <Button x:Name="RegisterSubmitBtn" Style="{StaticResource LoginButton}"
                                    Content="Registrarse" Margin="0,4,0,0" Click="RegisterSubmitBtn_Click"/>

                            <Button x:Name="BackToLoginBtn" Style="{StaticResource LinkButton}"
                                    Content="← Volver a iniciar sesión" Height="30" Margin="0,10,0,0"
                                    Click="BackToLogin_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Mensajes -->
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AccentRed}"
                                   FontSize="11.5" TextWrapping="Wrap" TextAlignment="Left"/>
                        <TextBlock x:Name="SuccessText" Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="11.5" TextWrapping="Wrap" TextAlignment="Left"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ================= IMAGEN (DERECHA, 55%) ================= -->
            <Border Grid.Column="1" CornerRadius="0,14,14,0" ClipToBounds="True">
                <Grid>
                    <Rectangle RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="pack://application:,,,/assets/china.jpg"
                                        Stretch="UniformToFill"
                                        AlignmentX="Center" AlignmentY="Center"/>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Fusión suave con el formulario: negro sólido -> transparente, 250 px -->
                    <Rectangle Width="250" HorizontalAlignment="Left">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF0A0A0C" Offset="0"/>
                                <GradientStop Color="#000A0A0C" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
            </Border>

            <!-- ================= BARRA DE TÍTULO ================= -->
            <Grid Grid.ColumnSpan="2" VerticalAlignment="Top" Height="40" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <Border Background="#8A0A0A0C" CornerRadius="9" Padding="2,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource WindowButton}" Content="&#xE921;"
                                ToolTip="Minimizar" Click="BtnMinimizar_Click"/>
                        <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;"
                                ToolTip="Cerrar (Esc)" Click="BtnCerrar_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
