<UserControl x:Class="HamulProto.UI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left" Background="{DynamicResource BgBrush}">
            <TextBlock Text="Ajustes" Foreground="{DynamicResource TextWhite}"
                       FontSize="28" FontWeight="Bold" Margin="0,0,0,28"/>

            <TextBlock Text="APARIENCIA" FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,12,20,12" VerticalAlignment="Center">
                    <TextBlock Text="Tema" Foreground="{DynamicResource TextWhite}"
                               FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Elige el aspecto de Hamul." Foreground="{DynamicResource SubTextBrush}"
                               FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="190" Height="36"
                          Style="{DynamicResource ThemeComboBox}" SelectionChanged="ThemeCombo_SelectionChanged">
                    <ComboBoxItem Content="Dark" Tag="Dark"/>
                    <ComboBoxItem Content="Light" Tag="Light"/>
                    <ComboBoxItem Content="Fire" Tag="Fire"/>
                </ComboBox>
                <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"/>
            </Grid>

            <TextBlock Text="AUDIO" FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,12,20,12" VerticalAlignment="Center">
                    <TextBlock Text="Volumen de los sonidos" Foreground="{DynamicResource TextWhite}"
                               FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Ajusta el volumen al reproducir efectos de sonido."
                               Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <DockPanel Grid.Column="1" Width="190" VerticalAlignment="Center">
                    <TextBlock x:Name="VolumeValue" DockPanel.Dock="Right" Width="42" TextAlignment="Right"
                               Foreground="{DynamicResource TextWhite}" FontSize="13" VerticalAlignment="Center"/>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" IsSnapToTickEnabled="True"
                            TickFrequency="1" Margin="0,0,8,0" VerticalAlignment="Center"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                </DockPanel>
                <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"/>
            </Grid>

            <TextBlock Text="IDIOMA" FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,12,20,12" VerticalAlignment="Center">
                    <TextBlock Text="Idioma de la interfaz" Foreground="{DynamicResource TextWhite}"
                               FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Selecciona el idioma de la interfaz." Foreground="{DynamicResource SubTextBrush}"
                               FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="190" Height="36"
                          Style="{DynamicResource ThemeComboBox}" SelectionChanged="LanguageCombo_SelectionChanged">
                    <ComboBoxItem Content="Español" Tag="es"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                </ComboBox>
                <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
