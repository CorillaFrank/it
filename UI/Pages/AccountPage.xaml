<UserControl x:Class="HamulProto.UI.Pages.AccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextGray}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,11"/>
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextWhite}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,11"/>
        </Style>

        <Style x:Key="LogoutButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentRed}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10"
                                Background="{DynamicResource TransparentBrush}"
                                BorderBrush="{DynamicResource AccentRed}" BorderThickness="1"
                                Padding="20,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentRed}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Cuenta" Foreground="{DynamicResource TextWhite}"
                       FontSize="28" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="Tu perfil y el estado de la sesión."
                       Foreground="{DynamicResource TextGray}" FontSize="12" Margin="0,0,0,24"/>

            <!-- Tarjeta principal con avatar, nickname y correo -->
            <Border Background="{DynamicResource CardBg}" CornerRadius="18"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                    Padding="24" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="76" Height="76" CornerRadius="38"
                            Background="{DynamicResource AccentGradient}" VerticalAlignment="Center">
                        <TextBlock x:Name="AvatarText" Text="?" FontSize="30" FontWeight="Black"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NicknameText" Text="Usuario" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextWhite}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="EmailText" Text="correo@ejemplo.com" FontSize="13"
                                   Foreground="{DynamicResource TextGray}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Detalle de la cuenta -->
            <TextBlock Text="INFORMACIÓN DE LA CUENTA" FontSize="10" FontWeight="Bold"
                       Foreground="{DynamicResource TextGray}" Margin="0,0,0,8"/>

            <Border Background="{DynamicResource CardBg}" CornerRadius="14"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                    Padding="20,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nickname" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="NicknameInfoText" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}"/>

                    <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1"
                            Background="{DynamicResource DividerBrush}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Correo" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="EmailInfoText" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}"/>

                    <Border Grid.Row="3" Grid.ColumnSpan="2" Height="1"
                            Background="{DynamicResource DividerBrush}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Estado" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="StatusText" Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldValue}"
                               FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <TextBlock x:Name="LoggedOutHint"
                       Text="No hay una sesión iniciada. Vuelve a iniciar sesión para ver tu perfil."
                       Foreground="{DynamicResource TextGray}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,18,0,0" Visibility="Collapsed"/>

            <Button x:Name="LogoutBtn" Style="{StaticResource LogoutButton}" Content="Cerrar sesión"
                    Click="Logout_Click" HorizontalAlignment="Left" Margin="0,24,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
