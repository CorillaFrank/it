<Window x:Class="HamulProto.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:HamulProto.UI.Pages"
        Title="Hamul - Panel de Control" Height="720" Width="1180" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource TransparentBrush}"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
               <ResourceDictionary Source="pack://application:,,,/Themes/Controls.xaml"/>
               <ResourceDictionary Source="pack://application:,,,/Themes/FireTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="14" Background="{DynamicResource WindowGradient}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== SIDEBAR ===================== -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarOverlayBrush}" CornerRadius="14,0,0,14"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="28,30,20,28">
                        <TextBlock Text="HAMUL" FontSize="28" FontWeight="Black"
                                   Foreground="{DynamicResource AccentGradient}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{DynamicResource AccentColorValue}" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="SOUND BOARD · PROTO" FontSize="10" Margin="2,2,0,0"
                                   Foreground="{DynamicResource TextGray}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="14,0">
                        <Button x:Name="BtnSoundWheel" Style="{StaticResource NavButton}" Tag="active"
                                Content="🎵  Sound Wheel" Click="ShowSoundWheel_Click"/>
                        <Button x:Name="BtnMySounds" Style="{StaticResource NavButton}"
                                Content="❤️  My Sounds" Click="ShowMySounds_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="🔍  Browse"/>
                        <Button x:Name="BtnSettings" Style="{StaticResource NavButton}" Content="⚙️  Settings" Click="ShowSettings_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="👤  Account"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="v0.1" Margin="30,0,0,22" FontSize="11"
                               Foreground="{DynamicResource TextGray}"/>
                </Grid>
            </Border>

            <!-- ===================== ÁREA DERECHA ===================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BARRA DE TÍTULO -->
                <Grid Grid.Row="0" Height="46" Background="{DynamicResource TransparentBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0">
                        <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click"/>
                        <Button Style="{StaticResource WindowButton}" Content="&#xE922;" Click="Maximize_Click"/>
                        <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;" Click="Exit_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="28,0,28,24">

                    <!-- ===================== VISTA 1: RUEDA ===================== -->
                    <Grid x:Name="SoundWheelView" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,18">
                            <TextBlock Text="Rueda de Sonidos" Foreground="{DynamicResource TextWhite}" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextGray}"
                                       Text="Arrastra un sonido a un sector  ·  clic en un sector para escucharlo  ·  clic derecho para vaciarlo"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="330"/>
                            </Grid.ColumnDefinitions>

                            <!-- La rueda -->
                            <Border Grid.Column="0" Background="{DynamicResource WheelBg}" CornerRadius="18"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="0,0,16,0">
                                <Viewbox Stretch="Uniform" Margin="16">
                                    <Canvas x:Name="WheelCanvas" Width="500" Height="500" Background="{DynamicResource TransparentBrush}"
                                            AllowDrop="True" Drop="WheelCanvas_Drop"
                                            DragOver="WheelCanvas_DragOver" DragLeave="WheelCanvas_DragLeave"/>
                                </Viewbox>
                            </Border>

                            <!-- Lista de sonidos -->
                            <Border Grid.Column="1" Background="{DynamicResource CardBg}" CornerRadius="18"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="4,2,0,12">
                                        <TextBlock Text="Tus sonidos" Foreground="{DynamicResource TextWhite}" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="Arrástralos a la rueda" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextGray}"/>
                                    </StackPanel>

                                    <ListBox x:Name="SoundsList" Grid.Row="1" Background="{DynamicResource TransparentBrush}" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource SoundRow}"
                                             PreviewMouseLeftButtonDown="AllSoundsList_PreviewMouseLeftButtonDown"
                                             MouseMove="AllSoundsList_MouseMove">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="32"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Style="{StaticResource IconButton}" Height="30" Content="▶"
                                                            Foreground="{DynamicResource AccentOrange}" Click="PlayPreview_Click" Tag="{Binding}"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextWhite}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Shortcut}" FontSize="10" Foreground="{DynamicResource TextGray}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Height="30" Content="✕"
                                                            Foreground="{DynamicResource AccentRed}" ToolTip="Eliminar de la lista"
                                                            Click="DeleteSound_Click" Tag="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ===================== VISTA 2: MIS SONIDOS ===================== -->
                    <Grid x:Name="MySoundsView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Encabezado: título + buscador + añadir -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Mis Sonidos" Foreground="{DynamicResource TextWhite}" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>

                            <Border Grid.Column="1" Width="260" Height="38" CornerRadius="19" Margin="0,0,14,0"
                                    Background="{DynamicResource ControlBgBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentOrange}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <TextBlock Text="🔍" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBox x:Name="SearchBox" Margin="38,0,14,0" Background="{DynamicResource TransparentBrush}" BorderThickness="0"
                                             Foreground="{DynamicResource TextWhite}" CaretBrush="{DynamicResource TextWhite}" FontSize="13"
                                             VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                                    <TextBlock Text="Buscar sonido…" Margin="40,0,0,0" VerticalAlignment="Center"
                                               FontSize="13" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextGray}"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="+ Añadir Sonido" Click="AddSound_Click"/>
                        </Grid>

                        <!-- Categorías -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="CATEGORÍAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextGray}" Margin="2,0,0,10"/>
                            <WrapPanel x:Name="CategoryPanel"/>
                        </StackPanel>

                        <!-- Tabla -->
                        <Border Grid.Row="2" Background="{DynamicResource CardBg}" CornerRadius="18"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Padding="14,16,14,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="8,0,8,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="NOMBRE" Foreground="{DynamicResource TextGray}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="2" Text="CATEGORÍA" Foreground="{DynamicResource TextGray}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="3" Text="ATAJO" Foreground="{DynamicResource TextGray}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="4" Text="AÑADIDO" Foreground="{DynamicResource TextGray}" FontSize="11" FontWeight="Bold"/>
                                </Grid>

                                <ListBox x:Name="AllSoundsList" Grid.Row="1" Background="{DynamicResource TransparentBrush}" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource SoundRow}"
                                         PreviewMouseLeftButtonDown="AllSoundsList_PreviewMouseLeftButtonDown"
                                         MouseMove="AllSoundsList_MouseMove"
                                         PreviewMouseRightButtonUp="AllSoundsList_PreviewMouseRightButtonUp">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="3*"/>
                                                    <ColumnDefinition Width="1.3*"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource IconButton}" Height="28" Width="30" HorizontalAlignment="Left"
                                                        Content="{Binding PlayIcon}" FontSize="13" Foreground="{DynamicResource AccentOrange}"
                                                        Click="PlayButton_Click" Tag="{Binding}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextWhite}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding CategoryLabel}" Foreground="{DynamicResource TextGray}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Shortcut}" Foreground="{DynamicResource AccentOrange}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Date}" Foreground="{DynamicResource TextGray}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock x:Name="EmptyText" Grid.Row="1" Text="No hay sonidos que mostrar." Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextGray}" FontSize="14"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <pages:SettingsPage x:Name="SettingsPage" Visibility="Collapsed"/>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
