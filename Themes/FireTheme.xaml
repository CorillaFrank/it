<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="MainBg" Color="#0A0A0D"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#121216"/>
    <SolidColorBrush x:Key="CardBg" Color="#15151A"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#2A2A33"/>
    <SolidColorBrush x:Key="TextWhite" Color="#F4F4F6"/>
    <SolidColorBrush x:Key="TextGray" Color="#8E8E9A"/>
    <SolidColorBrush x:Key="AccentColor" Color="#FF5A1F"/>
    <SolidColorBrush x:Key="AccentOrange" Color="#FF8A1F"/>
    <SolidColorBrush x:Key="AccentRed" Color="#E5252A"/>
    <SolidColorBrush x:Key="BgBrush" Color="#0A0A0D"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#332A2A33"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#A7A0A1"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#33FF5A1F"/>
    <SolidColorBrush x:Key="ControlBgBrush" Color="#1E1E26"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#2E2E38"/>
    <SolidColorBrush x:Key="ThumbBrush" Color="#44FFFFFF"/>
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="#99FF7A1A"/>
    <SolidColorBrush x:Key="MenuBgBrush" Color="#1A1A20"/>
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#E5252A"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="SidebarOverlayBrush" Color="#CC0C0C10"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <Color x:Key="AccentColorValue">#FFFF5A1F</Color>

    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0A0A0D" Offset="0"/>
        <GradientStop Color="#130709" Offset="0.55"/>
        <GradientStop Color="#2E0D10" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E5252A" Offset="0"/>
        <GradientStop Color="#FF8A1F" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="WheelBg" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                         RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#2E0E11" Offset="0"/>
        <GradientStop Color="#160A0C" Offset="0.55"/>
        <GradientStop Color="#0D0D11" Offset="1"/>
    </RadialGradientBrush>
</ResourceDictionary>
