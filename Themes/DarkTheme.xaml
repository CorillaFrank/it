<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Colores del Tema Oscuro (Dark) -->
    <SolidColorBrush x:Key="SidebarBg" Color="#1E1E28"/>
    <SolidColorBrush x:Key="MainBg" Color="#12121A"/>
    <SolidColorBrush x:Key="CardBg" Color="#191922"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#30303B"/>
    <SolidColorBrush x:Key="TextWhite" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextGray" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="AccentColor" Color="#5865F2"/>
    <SolidColorBrush x:Key="AccentOrange" Color="#7584FF"/>
    <SolidColorBrush x:Key="AccentRed" Color="#E74C3C"/>
    <SolidColorBrush x:Key="BgBrush" Color="#12121A"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#9AA0A6"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#335865F2"/>
    <SolidColorBrush x:Key="ControlBgBrush" Color="#191922"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#30303B"/>
    <SolidColorBrush x:Key="ThumbBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="#997584FF"/>
    <SolidColorBrush x:Key="MenuBgBrush" Color="#191922"/>
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#E74C3C"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="SidebarOverlayBrush" Color="#CC0C0C10"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <Color x:Key="AccentColorValue">#FF5865F2</Color>

    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#12121A" Offset="0"/>
        <GradientStop Color="#1E1E28" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#5865F2" Offset="0"/>
        <GradientStop Color="#7584FF" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="WheelBg" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#28283A" Offset="0"/>
        <GradientStop Color="#12121A" Offset="1"/>
    </RadialGradientBrush>
</ResourceDictionary>